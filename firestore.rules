rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Public read-only league data (written only by the automation script) ----------
    match /fixtures/{fixtureId} {
      allow read: if true;
      allow write: if false;
    }

    match /players/{playerId} {
      allow read: if true;
      allow write: if false;
    }

    match /highlights/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /topScorers/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /badges/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- Config: read by everyone, written by automation OR the admin (for table/awards lock/unlock) ----------
    match /config/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'somnathpatracbsa@gmail.com'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tableLocked', 'awardsLocked']);
    }

    // ---------- Users ----------
    match /users/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'joinedAt']);
    }

    // ---------- Match predictions: owner-only write, points/scored locked to false at write time ----------
    match /predictions/{predId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && predId == request.auth.uid + '_' + request.resource.data.fixtureId
        && request.resource.data.points == 0
        && request.resource.data.scored == false;
      allow delete: if false;
    }

    // ---------- Gameweek extras (top scoring team / clean sheet team / player guesses) ----------
    match /gwExtraPredictions/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.points == 0
        && request.resource.data.scored == false;
      allow delete: if false;
    }

    // ---------- Table predictions: owner-only, blocked while admin has locked it, can't self-set checkpoint points ----------
    match /tablePredictions/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['checkpointPoints'])
        && (
          get(/databases/$(database)/documents/config/current).data.tableLocked != true
          || request.auth.token.email == 'somnathpatracbsa@gmail.com' // ⚠️ replace with your exact Google account email
        );
      allow delete: if false;
    }

    // ---------- Season award predictions (Golden Boot etc.): owner-only, blocked while admin has locked it ----------
    match /seasonPredictions/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && (
          get(/databases/$(database)/documents/config/current).data.awardsLocked != true
          || request.auth.token.email == 'somnathpatracbsa@gmail.com'
        );
      allow delete: if false;
    }
  }
}
